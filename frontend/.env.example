# Frontend Environment Configuration

# API Base URL - Leave empty for local development (Vite proxies /api to port 5000)
# Set this only when the API is deployed separately, for example:
# VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=

# Optional Vite development proxy target (local API defaults to port 5000).
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Only used by old, currently unmounted screens if a separate legacy service exists.
VITE_AI_SERVICE_URL=
