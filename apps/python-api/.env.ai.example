# Copy this file to apps/python-api/.env.ai.local and put the real key there.
# Never commit a real API key.

# Recommended free configuration: Groq with ordered model failover.
# Create a NEW key at https://console.groq.com/keys
STUDYHUB_AI_PROVIDER=groq
GROQ_API_KEY=replace-with-your-new-groq-key
STUDYHUB_AI_BASE_URL=https://api.groq.com/openai/v1
STUDYHUB_AI_MODEL=openai/gpt-oss-120b
STUDYHUB_AI_TASK_MODEL=openai/gpt-oss-20b
STUDYHUB_AI_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
STUDYHUB_AI_TASK_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b

# Reliability and token budgets.
STUDYHUB_AI_TIMEOUT_SECONDS=45
STUDYHUB_AI_MAX_RETRIES=2
STUDYHUB_AI_RETRY_BASE_SECONDS=0.5
STUDYHUB_AI_MAX_INPUT_TOKENS=12000
STUDYHUB_AI_MAX_OUTPUT_TOKENS=1200
STUDYHUB_AI_TASK_MAX_OUTPUT_TOKENS=2000

# Optional cost estimates in USD per one million tokens. Keep 0 when unknown.
STUDYHUB_AI_INPUT_COST_PER_1M=0
STUDYHUB_AI_OUTPUT_COST_PER_1M=0
# STUDYHUB_AI_MODEL_PRICING_JSON={"openai/gpt-oss-120b":{"input_per_1m":0,"output_per_1m":0}}

# Alternative: OpenRouter selects an available free model automatically.
# STUDYHUB_AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=replace-with-your-openrouter-key
# STUDYHUB_AI_BASE_URL=https://openrouter.ai/api/v1
# STUDYHUB_AI_MODEL=openrouter/free
# STUDYHUB_AI_TASK_MODEL=openrouter/free

# Optional: force the deterministic offline engine.
# STUDYHUB_AI_PROVIDER=local

# Optional: local OpenAI-compatible runtime without an API key.
# STUDYHUB_AI_PROVIDER=ollama
# STUDYHUB_AI_BASE_URL=http://127.0.0.1:11434/v1
# STUDYHUB_AI_MODEL=qwen3:8b
# STUDYHUB_AI_TASK_MODEL=qwen3:8b
