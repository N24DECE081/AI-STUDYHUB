# Copy these values to apps/python-api/.env. Never commit real credentials.
STUDYHUB_GOOGLE_CLIENT_ID=your-google-client-id
STUDYHUB_GOOGLE_CLIENT_SECRET=your-google-client-secret
STUDYHUB_GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/oauth/google/callback

STUDYHUB_FACEBOOK_CLIENT_ID=your-facebook-client-id
STUDYHUB_FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
STUDYHUB_FACEBOOK_REDIRECT_URI=http://127.0.0.1:5000/api/auth/oauth/facebook/callback

STUDYHUB_FRONTEND_URL=http://127.0.0.1:5173
