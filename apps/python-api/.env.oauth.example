# Copy these values into .env. Never commit real secrets.
STUDYHUB_FRONTEND_URL=http://127.0.0.1:5173
STUDYHUB_GOOGLE_CLIENT_ID=your_google_client_id
STUDYHUB_GOOGLE_CLIENT_SECRET=your_google_client_secret
STUDYHUB_GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/oauth/google/callback

STUDYHUB_FACEBOOK_CLIENT_ID=your_facebook_client_id
STUDYHUB_FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
STUDYHUB_FACEBOOK_REDIRECT_URI=http://127.0.0.1:5000/api/auth/oauth/facebook/callback
