# Local API configuration. Set an exact comma-separated list; unlisted origins
# are denied browser access. Defaults cover Vite ports 5173-5175 on localhost.
STUDYHUB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# API gateway safeguards (per API process / client IP)
STUDYHUB_API_RATE_LIMIT_PER_MINUTE=120
STUDYHUB_API_BURST=30
STUDYHUB_AUTH_RATE_LIMIT_PER_MINUTE=10
STUDYHUB_AUTH_BURST=5
STUDYHUB_MAX_CONCURRENT_REQUESTS=32

# Keep credentials and other secrets local. Never commit real keys.
